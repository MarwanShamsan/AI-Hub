NODE_ENV=development

AUTH_API_PORT=4000
HOST=0.0.0.0

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_hub

JWT_ALG=EdDSA
JWT_KID=
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173,http://localhost:5174

EMAIL_PROVIDER=development

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=AI Hub <no-reply@example.com>

EMAIL_VERIFICATION_TTL_MINUTES=30
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_RESEND_WINDOW_MINUTES=15
EMAIL_VERIFICATION_RESEND_MAX_REQUESTS=5

CLIENT_APP_URL=http://localhost:5173
SUPPLIER_APP_URL=http://localhost:5174


PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
PASSWORD_RESET_REQUEST_WINDOW_MINUTES=15
PASSWORD_RESET_REQUEST_MAX_REQUESTS=5